+logger = init_logger(__name__)
+
+# --- b12x wrapper cross-layer dedup (workspace patch, 2026-08-22) -------------
+# Module-level geometry-keyed pool of B12xMoEWrapper instances. Enabled only
+# when VLLM_B12X_SHARED_WRAPPER=1; when disabled (default) behavior is
+# byte-identical to the unpatched module (each layer creates its own wrapper).
+#
+# Rationale (see ws-dedup-patch-2026-08-22.md): with use_cuda_graph=True each
+# B12xMoEWrapper pre-allocates its own static/dynamic workspace + _moe_output
+# sized for max_num_tokens. DSv4-Flash TP4 has 43 MoE layers with identical
+# geometry, so per-layer wrappers cost 43x the workspace (~0.3-0.65 GB/layer).
+# Sharing one wrapper per geometry reduces this to 1x. Sharing is safe because:
+#   * the wrapper is stateless w.r.t. weights — run() receives w1/w2 per call
+#     and its weight-view cache is keyed by data_ptr();
+#   * all layers execute serially on the same stream, so layer N+1 overwriting
+#     layer N's scratch is safe (write-before-read semantics per launch);
+#   * capacity is locked at max_num_tokens (use_cuda_graph=True); any resize
+#     need fails fast rather than corrupting captured graphs.
+_B12X_WRAPPER_POOL: "dict[tuple, Any]" = {}
+_B12X_WRAPPER_POOL_LOCK = threading.Lock()
+
+
+def _b12x_wrapper_pool_enabled() -> bool:
+    """VLLM_B12X_SHARED_WRAPPER=1 enables the shared wrapper pool (off=0)."""
+    return os.environ.get("VLLM_B12X_SHARED_WRAPPER", "0") == "1"
+
+
